// Initialize application (database connection and session)
require_once __DIR__ . '/init.php';

// Check if user is logged in
requireLogin();

// Include app utilities
require_once __DIR__ . '/app.php';

$settingsMessage = '';
$settingsMessageType = 'success';
if ($_SERVER['REQUEST_METHOD'] === 'POST' && ($_POST['action'] ?? '') === 'user_password') {
  $currentPassword = $_POST['current_password'] ?? '';
  $newPassword = $_POST['new_password'] ?? '';
  $confirmPassword = $_POST['confirm_password'] ?? '';
  $userId = (int) ($_SESSION['eastCoastUserId'] ?? 0);

  $stmt = $conn->prepare('SELECT password FROM regis_form WHERE id = ? LIMIT 1');
  if ($stmt) {
    $stmt->bind_param('i', $userId);
    $stmt->execute();
    $account = $stmt->get_result()->fetch_assoc();
    $stmt->close();
  }

  if (empty($account) || !password_verify($currentPassword, $account['password'])) {
    $settingsMessage = 'The current password is incorrect.';
    $settingsMessageType = 'error';
  } elseif (strlen($newPassword) < 6) {
    $settingsMessage = 'The new password must be at least 6 characters.';
    $settingsMessageType = 'error';
  } elseif ($newPassword !== $confirmPassword) {
    $settingsMessage = 'The new passwords do not match.';
    $settingsMessageType = 'error';
  } else {
    $hash = password_hash($newPassword, PASSWORD_DEFAULT);
    $update = $conn->prepare('UPDATE regis_form SET password = ? WHERE id = ?');
    $update->bind_param('si', $hash, $userId);
    $update->execute();
    $update->close();
    $settingsMessage = 'Password updated successfully.';
  }
}


