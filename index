<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>East Coast Secondary School · Management Portal</title>
  <meta name="description" content="The East Coast Secondary School management portal for student leaders, class monitors, teachers and administrators.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #0f1b2d;
      --ink-soft: #4a5a72;
      --paper: #f6f3ec;
      --card: #ffffff;
      --line: #e2dccf;
      --sea: #0c5c75;
      --sea-deep: #083f52;
      --sun: #f2a541;
      --radius: 18px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      color: var(--ink);
      background: var(--paper);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, .brand strong {
      font-family: 'Space Grotesk', 'DM Sans', sans-serif;
      letter-spacing: -0.02em;
      line-height: 1.1;
    }

    a { color: inherit; }

    .wrap { width: min(1120px, 100% - 48px); margin-inline: auto; }

    /* Header */
    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgba(246, 243, 236, 0.86);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
    }

    .bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }

    .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }

    .brand-mark {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: var(--sea);
      color: #fff;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 0.95rem;
    }

    .brand strong { display: block; font-size: 1.05rem; }
    .brand span { display: block; font-size: 0.8rem; color: var(--ink-soft); }

    nav ul { display: flex; gap: 28px; list-style: none; }
    nav a { text-decoration: none; font-weight: 500; font-size: 0.95rem; color: var(--ink-soft); }
    nav a:hover { color: var(--sea); }

    /* Hero */
    .hero {
      position: relative;
      overflow: hidden;
      background: linear-gradient(160deg, var(--sea-deep) 0%, var(--sea) 60%, #1c7f8f 100%);
      color: #fff;
      padding: 96px 0 120px;
    }

    .hero::after {
      content: '';
      position: absolute;
      inset: auto -10% -60px -10%;
      height: 140px;
      background: var(--paper);
      border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    }

    .hero-sun {
      position: absolute;
      right: 8%;
      top: 60px;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--sun) 0%, rgba(242, 165, 65, 0.35) 55%, transparent 72%);
      pointer-events: none;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .hero .eyebrow { color: #bfe3ea; }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #4ade80;
      box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.25);
    }

    .hero h1 {
      position: relative;
      font-size: clamp(2.4rem, 5.5vw, 4.2rem);
      max-width: 14ch;
      margin: 18px 0 20px;
    }

    .hero p {
      position: relative;
      max-width: 52ch;
      font-size: 1.1rem;
      color: #d6ecf0;
    }

    .actions { position: relative; display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px; }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 24px;
      border-radius: 999px;
      font-weight: 600;
      text-decoration: none;
      transition: transform 0.15s ease, background 0.15s ease;
    }

    .btn:hover { transform: translateY(-2px); }
    .btn-primary { background: var(--sun); color: var(--ink); }
    .btn-ghost { border: 1.5px solid rgba(255, 255, 255, 0.45); color: #fff; }
    .btn-ghost:hover { background: rgba(255, 255, 255, 0.1); }

    /* Sections */
    section { padding: 88px 0; }

    .section-head { max-width: 620px; margin-bottom: 44px; }
    .section-head .eyebrow { color: var(--sea); }
    .section-head h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin: 12px 0 14px; }
    .section-head p { color: var(--ink-soft); font-size: 1.05rem; }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 18px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 26px;
      transition: border-color 0.15s ease, transform 0.15s ease;
    }

    .card:hover { border-color: var(--sea); transform: translateY(-3px); }

    .icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: #e3f0f2;
      color: var(--sea);
      font-size: 1.25rem;
      margin-bottom: 18px;
    }

    .card h3 { font-size: 1.15rem; margin-bottom: 8px; }
    .card p { color: var(--ink-soft); font-size: 0.95rem; }

    /* Roles */
    .roles { background: var(--card); border-block: 1px solid var(--line); }

    .role-list { display: grid; gap: 14px; }

    .role {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 24px;
      align-items: center;
      padding: 22px 26px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--paper);
    }

    .role strong { font-family: 'Space Grotesk', sans-serif; font-size: 1.1rem; }

    .chips { display: flex; flex-wrap: wrap; gap: 8px; }

    .chip {
      font-size: 0.8rem;
      font-weight: 600;
      padding: 5px 12px;
      border-radius: 999px;
      background: #fff;
      border: 1px solid var(--line);
      color: var(--ink-soft);
    }

    /* CTA */
    .cta {
      background: var(--ink);
      color: #fff;
      border-radius: 28px;
      padding: 56px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
    }

    .cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); max-width: 20ch; }
    .cta p { color: #a9b6c9; margin-top: 10px; max-width: 46ch; }

    footer {
      padding: 36px 0 48px;
      color: var(--ink-soft);
      font-size: 0.9rem;
    }

    footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }

    @media (max-width: 720px) {
      nav { display: none; }
      .hero { padding: 72px 0 104px; }
      .hero-sun { width: 140px; height: 140px; right: -20px; top: 30px; }
      .role { grid-template-columns: 1fr; gap: 12px; }
      .cta { padding: 36px 28px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .btn, .card { transition: none; }
    }
  </style>
</head>
<body>
  <header>
    <div class="wrap bar">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">EC</span>
        <span><strong>East Coast</strong><span>Secondary School</span></span>
      </a>
      <nav aria-label="Main">
        <ul>
          <li><a href="#features">Features</a></li>
          <li><a href="#roles">Roles</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="hero-sun" aria-hidden="true"></div>
      <div class="wrap">
        <span class="eyebrow"><span class="dot"></span> Main campus · School management portal</span>
        <h1>Running our school, together.</h1>
        <p>One shared workspace for student leaders, class monitors, teachers and administrators to track cases, attendance, daily reports, tasks and announcements across East Coast Secondary School.</p>
        <div class="actions">
          <a class="btn btn-primary" href="#features">Explore the portal →</a>
          <a class="btn btn-ghost" href="#roles">Who it's for</a>
        </div>
      </div>
    </section>

    <section id="features">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Workspace</span>
          <h2>Everything the school team needs in one place</h2>
          <p>Each module is built around the everyday work of keeping students safe, informed and on track.</p>
        </div>
        <div class="grid">
          <article class="card">
            <div class="icon" aria-hidden="true">⌂</div>
            <h3>Overview</h3>
            <p>A live snapshot of open cases, pending tasks and today's activity across the campus.</p>
          </article>
          <article class="card">
            <div class="icon" aria-hidden="true">◈</div>
            <h3>Cases</h3>
            <p>Log, follow up and resolve student discipline and welfare cases with a clear history.</p>
          </article>
          <article class="card">
            <div class="icon" aria-hidden="true">▤</div>
            <h3>Daily reports</h3>
            <p>Teachers submit and review daily reports so nothing slips through the cracks.</p>
          </article>
          <article class="card">
            <div class="icon" aria-hidden="true">✓</div>
            <h3>Tasks</h3>
            <p>Assign duties to leaders and monitors, set deadlines and track completion.</p>
          </article>
          <article class="card">
            <div class="icon" aria-hidden="true">◷</div>
            <h3>Attendance</h3>
            <p>Class monitors record attendance quickly, giving teachers accurate daily records.</p>
          </article>
          <article class="card">
            <div class="icon" aria-hidden="true">♢</div>
            <h3>Announcements</h3>
            <p>Share school news and notices with every role from a single noticeboard.</p>
          </article>
          <article class="card">
            <div class="icon" aria-hidden="true">◎</div>
            <h3>Leadership team</h3>
            <p>Manage the student leadership roster, positions and responsibilities.</p>
          </article>
          <article class="card">
            <div class="icon" aria-hidden="true">▥</div>
            <h3>Performance</h3>
            <p>Statistics and trends that help staff spot patterns and act early.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="roles" class="roles">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Access by role</span>
          <h2>The right tools for every member of the team</h2>
          <p>Each person sees only the parts of the portal that match their responsibilities.</p>
        </div>
        <div class="role-list">
          <div class="role">
            <strong>Student leader</strong>
            <div class="chips">
              <span class="chip">Overview</span><span class="chip">Cases</span><span class="chip">Tasks</span><span class="chip">Announcements</span>
            </div>
          </div>
          <div class="role">
            <strong>Class monitor</strong>
            <div class="chips">
              <span class="chip">Overview</span><span class="chip">Attendance</span><span class="chip">Cases</span><span class="chip">Tasks</span><span class="chip">Announcements</span>
            </div>
          </div>
          <div class="role">
            <strong>Teacher</strong>
            <div class="chips">
              <span class="chip">Overview</span><span class="chip">Cases</span><span class="chip">Daily reports</span><span class="chip">Tasks</span><span class="chip">Attendance</span><span class="chip">Announcements</span><span class="chip">Performance</span>
            </div>
          </div>
          <div class="role">
            <strong>Administrator</strong>
            <div class="chips">
              <span class="chip">Full access</span><span class="chip">Leadership team</span><span class="chip">Settings</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="wrap">
        <div class="cta">
          <div>
            <h2>Need access to the portal?</h2>
            <p>Accounts are created by the school administration. Speak to your class teacher or the school office to get set up.</p>
          </div>
          <a class="btn btn-primary" href="#top" onclick="window.scrollTo({ top: 0, behavior: 'smooth' }); return false;">Back to top ↑</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <span>© <span id="year">2026</span> East Coast Secondary School</span>
      <span>Main campus</span>
    </div>
  </footer>

  <script>
    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
</body>
</html>